# Public site URL. Used for:
#   - Mercado Pago back_urls / notification_url in /api/checkout
#   - Email links (password reset, magic links, etc.) via lib/auth-actions
#
# En Vercel se setea como env var del proyecto (Production/Preview/Development).
# Si falta, el código cae a http://localhost:3000 — eso rompe los pagos reales.
NEXT_PUBLIC_SITE_URL=https://barlovento-oy5q.vercel.app

# Supabase (cliente público)
