# Fase 4 (checkout Mercado Pago + captura WhatsApp).
# Token de acceso a la API de Mercado Pago (crear en
# https://www.mercadopago.com.ar/developers/panel/credentials).
MERCADO_PAGO_ACCESS_TOKEN=YOUR-MP-ACCESS-TOKEN

# URL pública del sitio, usada por Mercado Pago para volver al checkout
# (success/failure/pending) y para armar los back_urls de la Preference.
NEXT_PUBLIC_SITE_URL=http://localhost:3000